#NoEnv
#SingleInstance force

; ==============================================================================
; F9: Дисциплинарный устав — Повседневная служба, режим и быт (ОСБ)
; ==============================================================================
F4::
State_DU1 := !State_DU1

If State_DU1
{
    CustomColor_DU1 = EEAA99
    Gui, DU1:Destroy
    Gui, DU1:+LastFound +AlwaysOnTop -Caption +ToolWindow 
    Gui, DU1:Color, black
    Gui, DU1:Font, s7 cWhite w1000
    Gui, DU1:Add, Text, cYellow, =====================[Дисциплинарный Устав — Служба и Порядок (ОСБ)]========================
    Gui, DU1:Add, Text, cRed, [Статья]     [Расшифровка]                                                      [Наказание]
    Gui, DU1:Add, Text, cYellow, 6           Неподчинение законным требованиям сотрудника ОСБ / Воен. полиции     Дисципл. отв-ть
    Gui, DU1:Add, Text, cYellow, 9           Нарушение субординации (приветствие, рапорт, дистанция, обращение)  Предупр. / Выговор
    Gui, DU1:Add, Text,,         14          Оскорбление сослуживца / гражданина / мат в строю или при исп-ии     Предупр. / Выговор / Стр. выговор
    Gui, DU1:Add, Text, cYellow, 22          Нарушение формы одежды (нет шевронов/знаков, не по уставу)          Предупр. / Выговор (сокрытие: Стр. выг)
    Gui, DU1:Add, Text,,         23          Ношение военной формы одежды вне службы                              Предупр. / Выговор
    Gui, DU1:Add, Text, cYellow, 24          Хранение / употр. алкоголя / наркотиков / отказ от освидетельств.   Стр. выговор / Увольнение
    Gui, DU1:Add, Text, cYellow, 34          Самовольное оставление части (СОЧ / прогул в форме / дела в городе)  Выговор / Увольнение
    Gui, DU1:Add, Text,,         34.1        Опоздание / неявка на построение, наряд, патруль, проверку          Выговор
    Gui, DU1:Add, Text, cYellow, 34.2        Уклонение от службы (уход с поста, караула, кач зп в казарме)        Стр. выговор / Понижение
    Gui, DU1:Add, Text,,         47.1        Нарушение правил хранения оружия, БП, спецсредств                    Выговор
    Gui, DU1:Add, Text, cYellow, 47.2        Нарушение правил обращения с оружием (стрельба без причины)          Выговор / Стр. выговор
    Gui, DU1:Add, Text,,         47.3        Передача оружия, БП, спецсредств без разрешения                      Стр. выговор / Увольнение
    Gui, DU1:Add, Text, cYellow, 47.4        Утрата / порча оружия, имущества, служебного транспорта              Выговор / Понижение / Увольнение
    Gui, DU1:Add, Text,,         70.1        Просрочка увольнительной (15-60 мин — выговор; 60+ мин — СОЧ ст.34)  Предупр. / Выговор / Увольнение
    Gui, DU1:Add, Text, cYellow, 77          Нарушение поведения на плацу (бег в строю, курение, телефон, вид)   Предупр. / Выговор
    Gui, DU1:Add, Text,,         78          Нарушение в казарме (шум после отбоя, музыка в войс, посторонние)    Предупр. / Выговор
    Gui, DU1:Add, Text,,         79          Курение / вейп в неположенном месте (вне спец. курилки)              Предупр. / Выговор
    Gui, DU1:Add, Text,,         80          Гражданская одежда в части (полковник+ только с разрешения Лидера)   Выговор
    Gui, DU1:Add, Text, cYellow, 83          Нарушение пропускного режима / неведение журналов КПП / посторонние  Выговор / Понижение
    Gui, DU1:Add, Text,,         84          Азартные игры и пари на территории части                             Выговор / Стр. выговор
    Gui, DU1:Add, Text, cYellow, 89          Нарушение парковки / въезд на личном авто не по уставу               Предупр. / Выговор
    Gui, DU1:Add, Text, cYellow, 90          Нарушение позывного в служебной связи / рации (нет тега)             Выговор (срыв: Увольнение)
    Gui, DU1:Add, Text,,         91          Умышленное уклонение от служебной связи (игнор рации)                Выговор
    Gui, DU1:Add, Text,,         92          Нарушение порядка связи (флуд, бред, ложная инфа)                    Выговор

    WinSet, TransColor, %CustomColor_DU1% 180
    Gui, DU1:Show, x5 y1 NoActivate, window_du1.
}
Else
    Gui, DU1:Destroy
Return


; ==============================================================================
; F10: Дисциплинарный устав — Коррупция, превышение власти, преступления (ОСБ)
; ==============================================================================

F5::
State_DU2 := !State_DU2

If State_DU2
{
    CustomColor_DU2 = EEAA99
    Gui, DU2:Destroy
    Gui, DU2:+LastFound +AlwaysOnTop -Caption +ToolWindow 
    Gui, DU2:Color, black
    Gui, DU2:Font, s7 cWhite w1000
    
    Gui, DU2:Add, Text, cYellow, =====================[Дисциплинарный Устав — Профиль ОСБ / Преступления]========================
    Gui, DU2:Add, Text, cRed, [Статья]     [Расшифровка]                                                      [Наказание]
    Gui, DU2:Add, Text, cYellow, 56          Хищение военного имущества (оружие, броня, БП, кража, слив)          Увольнение + передача в СК
    Gui, DU2:Add, Text,,         57          Порочение чести и достоинства военнослужащего (аморальное поведение) Выговор / Стр. выговор
    Gui, DU2:Add, Text, cYellow, 58          Дискредитация ВС / ФСВНГ (публичные заявления, медиа, урон имиджу)   Стр. выговор / Увольнение
    Gui, DU2:Add, Text, cYellow, 59          Разглашение гостайны / военной тайны (слив маршрутов, операций)     Увольнение + передача в ФСБ
    Gui, DU2:Add, Text, cYellow, 59.1        Использование служебной информации в личных целях (пробив по базам)  Стр. выговор / Увольнение
    Gui, DU2:Add, Text,,         65          Неуставные взаимоотношения (дедовщина, вымогательство денег/вещей)    Выговор / Увольнение + СК
    Gui, DU2:Add, Text, cYellow, 67          Фальсификация служебных документов (рапорты, журналы КПП, отчеты)    Выговор + Пониж. (офицеры: Увал)
    Gui, DU2:Add, Text, cYellow, 68          Конфликт интересов (блат, покрытие родственников / друзей)           Выговор (при ущербе: Увольнение)
    Gui, DU2:Add, Text,,         69          Ложный донос / клевета на сослуживца (попытка слить коллегу)         Выговор / Увольнение
    Gui, DU2:Add, Text, cYellow, 71          Воспрепятствование работе ОСБ / прокуратуры (уничтожение улик, укрывательство) Стр. выговор / Увольнение
    Gui, DU2:Add, Text,,         73          Халатность (неисполнение обязанностей по небрежности)                Выговор / Понижение
    Gui, DU2:Add, Text, cYellow, 74          Связи с криминалом (участие в сходках, помощь ОПГ, взятки услугами)  Понижение / Увольнение
    Gui, DU2:Add, Text, cYellow, 75          Превышение должностных полномочий (действия сверх своих прав)        Выговор / Увольнение
    Gui, DU2:Add, Text, cYellow, 82          Недонесение о готовящемся или совершенном преступлении (покрывательство) Выговор (тяжкие: Увольнение)
    Gui, DU2:Add, Text,,         85          Самоуправство (совершение действий без всяких полномочий)            Выговор / Понижение
    Gui, DU2:Add, Text, cYellow, 87          Использование служебного положения в личных целях (взятки, выгода)   Увольнение + ВП / ФСБ

    WinSet, TransColor, %CustomColor_DU2% 180
    Gui, DU2:Show, x5 y1 NoActivate, window_du2.
}
Else
    Gui, DU2:Destroy
Return